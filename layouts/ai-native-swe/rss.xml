{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} | {{ .Site.Title }}</title>
    {{ with .OutputFormats.Get "HTML" }}<link>{{ .Permalink }}</link>{{ end }}
    <description>{{ .Description }}</description>
    <language>{{ .Site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{ range where (partial "blogs/published.html" .) "Params.series" .Params.series }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Summary | plainify }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
